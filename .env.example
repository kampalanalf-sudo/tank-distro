# Optional restaurant backend overrides. The approved project has public defaults
# in src/delivery/api.ts, so these are not needed for the connected live preview.
# VITE_DELIVERY_SUPABASE_URL=https://your-restaurant-project.supabase.co
# VITE_DELIVERY_SUPABASE_KEY=your-publishable-key

# live = send checkout to the backend; demo = device-only demo checkout.
VITE_DELIVERY_MODE=live

# Never use a service-role key or database password in VITE_ variables.
# Legacy radio environment variables are not used by the restaurant app.
